#!/bin/bash
# The full gate in the Rust image: cargo test (debug and release) and pytest, against the small
# count-corpus tier committed in tests/corpus-small (scripts/build_small_corpus.py). The full
# corpus (~780 MB, outside git) stays local: run the suite without MD_COUNT_CORPUS_DIR. cargo
# fetches edge-rust, so the step needs the token (scripts/gh-token.sh).
# Usage: scripts/test
set -e
REPO=$(cd "$(dirname "$0")/.." && pwd)
export COPYFILE_DISABLE=1   # macOS tar: no AppleDouble ._ files in the stream
RUST_IMAGE=rust:1.95.0      # keep equal to rust-toolchain.toml
UV_VERSION=0.12.6
source "$REPO/scripts/gh-token.sh"

echo "--- :rust: cargo test (debug + release), pytest"
git -C "$REPO" ls-files -z | tar -C "$REPO" --null -T - -cf - \
  | docker run -i --rm --platform linux/amd64 "${GIT_TOKEN_ARGS[@]}" \
    -e MD_COUNT_CORPUS_DIR=/work/tests/corpus-small "$RUST_IMAGE" sh -c \
    "$GIT_TOKEN_SH && mkdir /work && cd /work && tar -xf - \
     && cargo test --workspace --locked && cargo test --workspace --release --locked \
     && curl -LsSf https://astral.sh/uv/$UV_VERSION/install.sh | sh \
     && ~/.local/bin/uv run pytest -q"
